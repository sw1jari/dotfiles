#!/bin/bash
# Fixes pitched down / slowed audio after apps fight over the sample rate.
# Turning the sound card profile off and back on makes PipeWire reopen the
# device at the graph rate and renegotiate the clock with the interface.
# If one Firefox tab is still off afterwards, reloading that tab resets its
# own resampler.
#
# Run it from dmenu_run, or with "pick" to choose a card from a dmenu list.

notify() { dunstify -r 9902 -a audio-fix "$@"; }

sink=$(pactl get-default-sink)
card=$(pactl list sinks | awk -v s="$sink" '
    $1 == "Name:" { found = ($2 == s) }
    found && $1 == "device.name" { gsub(/"/, "", $3); print $3; exit }
')

if [ "$1" = "pick" ]; then
    card=$(pactl list short cards | awk '{print $2}' | dmenu -p "reset card:") || exit 0
fi

if [ -z "$card" ]; then
    notify -u critical "Audio fix" "Could not find the card behind $sink"
    exit 1
fi

profile=$(pactl list cards | awk -v c="$card" '
    $1 == "Name:" { found = ($2 == c) }
    found && /Active Profile:/ { print $3; exit }
')

if [ -z "$profile" ] || [ "$profile" = "off" ]; then
    notify -u critical "Audio fix" "$card has no active profile to restore"
    exit 1
fi

notify "Audio fix" "Resetting ${card#alsa_card.}"

pactl set-card-profile "$card" off
sleep 1
pactl set-card-profile "$card" "$profile"

# Wait for the sink to come back, then put it back as default and pull every
# stream onto it, since some clients stay on whatever sink they fell back to.
for _ in $(seq 20); do
    pactl list short sinks | grep -q "^[0-9]*[[:space:]]$sink[[:space:]]" && break
    sleep 0.2
done
pactl set-default-sink "$sink"
for input in $(pactl list short sink-inputs | awk '{print $1}'); do
    pactl move-sink-input "$input" "$sink" 2>/dev/null
done

rate=$(pactl list short sinks | awk -v s="$sink" '$2 == s {print $6}')
notify "Audio fix" "${card#alsa_card.} back at ${rate:-unknown rate}"
